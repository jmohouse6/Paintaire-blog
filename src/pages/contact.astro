---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with the Paintaire team — questions about our painting services, the blog, or partnership inquiries."
  keywords={['contact paintaire', 'painting services', 'get a quote', 'painting inquiry']}
>
  <div class="max-w-5xl mx-auto">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-primary dark:text-accent mb-4">Contact Us</h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Have a question or a project in mind? Send us a message and we'll get back to you.
      </p>
    </header>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="md:col-span-2">
        <!-- Posts same-origin to /api/leads by default; PUBLIC_CONTACT_ENDPOINT overrides with a direct POST -->
        <form
          id="contact-form"
          class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md"
        >
          <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4">Send Us a Message</h2>

          <div class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary dark:focus:ring-accent focus:border-transparent dark:bg-gray-700 dark:text-white"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email Address</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary dark:focus:ring-accent focus:border-transparent dark:bg-gray-700 dark:text-white"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                placeholder="What's this about?"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary dark:focus:ring-accent focus:border-transparent dark:bg-gray-700 dark:text-white"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell us more..."
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary dark:focus:ring-accent focus:border-transparent dark:bg-gray-700 dark:text-white"
              ></textarea>
            </div>

            <p id="contact-error" class="hidden text-sm text-red-600 dark:text-red-400"></p>

            <button
              type="submit"
              class="w-full bg-primary hover:bg-secondary dark:bg-accent dark:hover:bg-secondary text-white font-medium py-2 px-4 rounded-md transition-colors"
            >
              Send Message
            </button>
          </div>
        </form>
      </div>

      <aside class="space-y-6">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md">
          <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4">Contact Information</h2>
          <div class="space-y-3 text-gray-600 dark:text-gray-300">
            <p>
              <span class="font-medium text-gray-800 dark:text-white">Email:</span><br />
              <a href="mailto:info@paintaire.com" class="text-primary dark:text-accent hover:underline">info@paintaire.com</a>
            </p>
            <p>
              <span class="font-medium text-gray-800 dark:text-white">Services:</span><br />
              Residential &amp; Commercial Painting
            </p>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md">
          <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4">Before You Write</h2>
          <p class="text-gray-600 dark:text-gray-300">
            Looking for painting tips? Browse our <a href="/blog" class="text-primary dark:text-accent hover:underline">blog</a> — your question may already be answered there.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const target = e.target as HTMLFormElement;
    const formData = new FormData(target);
    const errorEl = document.getElementById('contact-error');
    const button = form.querySelector('button');

    // Set PUBLIC_CONTACT_ENDPOINT to POST messages directly to a backend;
    // otherwise POST same-origin to /api/leads, which forwards to the CRM.
    const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/leads';

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...Object.fromEntries(formData.entries()), form: 'contact' }),
      });
      if (res.status !== 503 && !res.ok) throw new Error(`HTTP ${res.status}`);
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = 'Something went wrong sending your message. Please try again.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    errorEl?.classList.add('hidden');
    if (button) {
      const originalText = button.textContent;
      button.textContent = 'Message Sent!';
      button.disabled = true;

      setTimeout(() => {
        button.textContent = originalText;
        button.disabled = false;
        target.reset();
      }, 3000);
    }
  });
</script>
