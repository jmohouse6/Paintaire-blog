---
import NewsletterForm from './NewsletterForm.astro';
import { getSiteSettings } from '../utils/settings';

const currentYear = new Date().getFullYear();
const settings = await getSiteSettings();

const socialIcons: Record<string, string> = {
  twitter:
    'M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84',
  linkedin:
    'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z',
  facebook:
    'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
};
---

<footer class="bg-primary dark:bg-gray-800 text-white py-12">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      <div>
        <h3 class="text-xl font-bold mb-4">{settings.title}</h3>
        <p class="text-gray-300 dark:text-gray-400">
          {settings.description}
        </p>
      </div>
      <div>
        <h3 class="text-xl font-bold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/blog" class="text-gray-300 dark:text-gray-400 hover:text-white">Blog</a></li>
          <li><a href="/about" class="text-gray-300 dark:text-gray-400 hover:text-white">About</a></li>
          <li><a href="/contact" class="text-gray-300 dark:text-gray-400 hover:text-white">Contact</a></li>
        </ul>
      </div>
      {settings.socialLinks.length > 0 && (
        <div>
          <h3 class="text-xl font-bold mb-4">Follow Us</h3>
          <div class="flex space-x-4">
            {settings.socialLinks.map(({ platform, url }) => (
              <a href={url} class="text-gray-300 dark:text-gray-400 hover:text-white" rel="noopener noreferrer" target="_blank">
                <span class="sr-only">{platform}</span>
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d={socialIcons[platform]} />
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="mt-12 border-t border-gray-700 dark:border-gray-600 pt-8">
      <NewsletterForm />
    </div>

    <div class="mt-8 pt-8 border-t border-gray-700 dark:border-gray-600 text-center">
      <p class="text-gray-300 dark:text-gray-400">&copy; {currentYear} {settings.title}. All rights reserved.</p>
    </div>
  </div>
</footer>