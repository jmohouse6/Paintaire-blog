---
---
<form 
  id="newsletter-form"
  class="max-w-md mx-auto bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md"
>
  <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-4">Subscribe to Our Newsletter</h3>
  <p class="text-gray-600 dark:text-gray-300 mb-4">Get the latest painting tips and industry news delivered to your inbox.</p>
  
  <div class="space-y-4">
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email Address</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="you@example.com"
        class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary dark:focus:ring-accent focus:border-transparent dark:bg-gray-700 dark:text-white"
      />
    </div>
    
    <div class="flex items-start">
      <input
        type="checkbox"
        id="privacy"
        name="privacy"
        required
        class="mt-1 h-4 w-4 text-primary dark:text-accent border-gray-300 dark:border-gray-600 rounded"
      />
      <label for="privacy" class="ml-2 block text-sm text-gray-600 dark:text-gray-300">
        I agree to receive marketing emails and accept the <a href="/privacy" class="text-primary dark:text-accent hover:underline">privacy policy</a>.
      </label>
    </div>

    <p id="newsletter-error" class="hidden text-sm text-red-600 dark:text-red-400"></p>

    <button
      type="submit"
      class="w-full bg-primary hover:bg-secondary dark:bg-accent dark:hover:bg-secondary text-white font-medium py-2 px-4 rounded-md transition-colors"
    >
      Subscribe
    </button>
  </div>
</form>

<script>
  const form = document.getElementById('newsletter-form');
  // Set PUBLIC_NEWSLETTER_ENDPOINT to POST subscriptions to a real backend;
  // when unset, a successful submission is simulated locally.
  const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const target = e.target as HTMLFormElement;
    const formData = new FormData(target);
    const email = formData.get('email');
    const errorEl = document.getElementById('newsletter-error');
    const button = form.querySelector('button');

    const showError = (message: string) => {
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      }
    };

    const showSuccess = () => {
      if (button) {
        const originalText = button.textContent;
        button.textContent = 'Subscribed!';
        button.disabled = true;

        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
          target.reset();
        }, 3000);
      }
    };

    errorEl?.classList.add('hidden');

    if (endpoint) {
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(`Request failed: ${res.status}`);
        showSuccess();
      } catch (err) {
        console.error('Newsletter subscription failed:', err);
        showError('Something went wrong. Please try again.');
      }
    } else {
      console.log('Subscription request for:', email);
      showSuccess();
    }
  });
</script>