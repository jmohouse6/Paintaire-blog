---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Get author data
const authors = await getCollection('authors');
const author = authors.find(a => a.slug === post.data.author);

const youtubeId = post.data.youtubeUrl?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?/]+)/)?.[1];

const readingTime = Math.max(1, Math.round(post.body.split(/\s+/).length / 200));

const relatedPosts = (await getCollection('posts'))
  .filter(p => p.slug !== post.slug && p.data.categories.some(c => post.data.categories.includes(c)))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 3);

// Extract keywords from categories and title
const keywords = [
  ...post.data.categories,
  ...post.data.title.toLowerCase().split(' '),
  'painting',
  'paint tips',
  'professional painting',
  author?.data.name.toLowerCase() || ''
].filter(Boolean);
---

<BaseLayout 
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.image}
  type="article"
  publishedDate={post.data.publishedDate}
  author={author?.data.name}
  keywords={keywords}
>
  <article class="max-w-4xl mx-auto" itemscope itemtype="http://schema.org/BlogPosting">
    <meta itemprop="datePublished" content={post.data.publishedDate.toISOString()} />
    {author && <meta itemprop="author" content={author.data.name} />}
    
    <!-- Header -->
    <header class="mb-8">
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-[400px] object-cover rounded-lg mb-6"
          itemprop="image"
        />
      )}
      <h1 class="text-4xl font-bold text-primary dark:text-white mb-4" itemprop="headline">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-6 text-gray-600 dark:text-gray-300 mb-4">
        <div class="flex items-center gap-2" itemprop="author" itemscope itemtype="http://schema.org/Person">
          {author?.data.avatar && (
            <img
              src={author.data.avatar}
              alt={author.data.name}
              class="w-8 h-8 rounded-full"
            />
          )}
          {author ? (
            <a href={`/authors/${author.slug}`} class="hover:text-primary dark:hover:text-white" itemprop="name">
              {author.data.name}
            </a>
          ) : (
            <span itemprop="name">{author?.data.name}</span>
          )}
        </div>
        <time datetime={post.data.publishedDate.toISOString()} itemprop="datePublished">
          {new Date(post.data.publishedDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span>{readingTime} min read</span>
      </div>
      <div class="flex gap-2">
        {post.data.categories.map(category => (
          <a
            href={`/blog?category=${category}`}
            class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm hover:bg-gray-200 dark:hover:bg-gray-600"
          >
            {category.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}
          </a>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose dark:prose-invert prose-lg max-w-none" itemprop="articleBody">
      <Content />
    </div>

    {youtubeId && (
      <div class="mt-8 aspect-video">
        <iframe
          src={`https://www.youtube.com/embed/${youtubeId}`}
          title={post.data.title}
          class="w-full h-full rounded-lg"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {relatedPosts.length > 0 && (
      <section class="mt-12 pt-8 border-t dark:border-gray-700">
        <h2 class="text-2xl font-bold text-primary dark:text-white mb-6">Related Articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map(related => (
            <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
              {related.data.image && (
                <img
                  src={related.data.image}
                  alt={related.data.title}
                  class="w-full h-32 object-cover"
                />
              )}
              <div class="p-4">
                <h3 class="font-semibold mb-1">
                  <a href={`/blog/${related.slug}`} class="text-primary dark:text-white hover:text-secondary dark:hover:text-accent">
                    {related.data.title}
                  </a>
                </h3>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  {new Date(related.data.publishedDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <Comments />
  </article>
</BaseLayout>